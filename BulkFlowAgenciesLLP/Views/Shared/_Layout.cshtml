                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="scroll-top-percentage"><span id="scroll-value"></span></div>

    <a href="https://wa.me/+917738406968" class="whatsapp-button" target="_blank">
        <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WhatsApp">
    </a>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/fontawesome.min.js"></script>
    <script src="~/js/core.min.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/glightbox.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const lightbox = GLightbox({
                selector: '.glightbox',
                touchNavigation: true,
                loop: true
            });
        });
    </script>

    <script>
         function setEqualHeight() {
            var maxHeight = 0;
            $('.TestimonialCard').css('height', 'auto'); // Reset height
            $('.TestimonialCard').each(function () {
                var thisHeight = $(this).outerHeight();
                if (thisHeight > maxHeight) {
                    maxHeight = thisHeight;
                }
            });
            $('.TestimonialCard').css('height', maxHeight + 'px');
        }
        $(document).ready(setEqualHeight);
        $(window).resize(setEqualHeight);
    </script>

    <script>
        $(document).ready(function() {
            var maxHeight = 0;

            // Loop through each h4 inside .seprator-border to find the tallest one
            $('.seprator-border h4').each(function() {
                var currentHeight = $(this).outerHeight();
                if (currentHeight > maxHeight) {
                    maxHeight = currentHeight;
                }
            });

            // Set the height of all h4s to the tallest one
            $('.seprator-border h4').css('height', maxHeight);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
