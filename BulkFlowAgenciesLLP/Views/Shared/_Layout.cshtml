                    <div class="d-flex mb-1-9">
                        <div class="flex-shrink-0"><img src="~/images/icons/icon-phone.png" alt="..."></div>
                        <div class="flex-grow-1 ms-3">
                            <h4 class="mb-1 h6 text-white">Contact Us</h4>
                            <p class="mb-0 text-white"><a href="tel:+917738406968" class="text-white">+91 77384 06968</a></p>
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="flex-shrink-0"><img src="~/images/icons/icon-mail.png" alt="..."></div>
                        <div class="flex-grow-1 ms-3">
