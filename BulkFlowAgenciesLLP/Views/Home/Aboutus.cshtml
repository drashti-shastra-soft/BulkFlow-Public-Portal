@{
    ViewBag.Title = "About Bulk Flo Agencies LLP - Your Reliable Tool Distributor";
    ViewBag.MetaDescription = "Learn about Bulk Flo Agencies LLP, a leading tool distributor in Mumbai, offering Manlid Assemblies, Relief Valves, Safety Equipment, and custom solutions. Established to deliver quality products to meet specific industrial needs.";
    ViewBag.MetaKeywords = "Tool Distributor, Industrial Equipment Supplier, Mumbai Tool Distributors, Bulk Flo Agencies, Custom Components, Safety Equipment Supplier";
}

<section class="page-title-section bg-img cover-background top-position1 AboutusBreadcrumbSection" data-overlay-dark="3">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1>About Us</h1>
                <ul>
                    <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li>About Us</li>
                </ul>
            </div>
        </div>
    </div>
    <span class="triangle-3 z-index-1 d-none d-sm-inline-block"></span>
    <span class="triangle-4 z-index-1 d-none d-sm-inline-block"></span>
    <img src="~/images/content/dots2.png" class="position-absolute right-5 bottom-5 ani-top-bottom z-index-3 d-none d-sm-block" alt="...">
    <div class="page-title-round ani-move"></div>
</section>

<section class="about-us-section">
    <div class="container">
        <div class="row mt-n2-9 position-relative z-index-9 custom-flex">
            <div class="row">
                <div class="col-lg-6 wow fadeIn" data-wow-delay="200ms">
                    <div class="">
                        <h2 class="mb-lg-1-9">Welcome to <span style="color: #E8B955;">Bulk Flo Agencies LLP</span></h2>
                        <blockquote>Your Trusted Partner in ISO Tank Spares</blockquote>
                        @* <p class="display-25 mb-lg-1-9 text-secondary"></p> *@
                        <p>At Bulk Flo Agencies LLP, we specialize in the supply of high-quality spare parts for ISO tanks, serving the global logistics and bulk liquid transportation industries. With a strong commitment to reliability, safety, and customer satisfaction, we provide a comprehensive range of components—including valves, gaskets, pressure relief devices, and fittings—sourced from trusted manufacturers.</p>
                        <p>
                            Our expert team understands the critical nature of ISO tank operations and offers tailored solutions to ensure minimal downtime and maximum performance. Whether you're managing a fleet or maintaining individual tanks, we are your dependable partner for prompt delivery, technical support, and industry-compliant parts.
                        </p>
                    </div>
                </div>
                <div class="col-lg-6 wow fadeIn" data-wow-delay="100ms">
                    <div class="image-hover d-inline-block z-index-1">
                        @* <img src="~/images//" /> *@
                        <img src="~/images/external/AboutJourney.jpg" class="rounded" alt="About Image1" />
                        @* <img src="~/images/external/content/maparea.png" > *@
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 wow fadeIn" data-wow-delay="200ms">
                    <h2 class="mb-lg-1-9">Our Products Introduction – ISO Tank Spares</h2>
                    <p>At Bulk-flo agencies LLP, we are a trusted supplier of high-quality ISO Tank spares, supporting the global logistics and transportation industry with reliable components designed for performance, safety, and regulatory compliance.</p>
                    <p>Our product range is engineered to meet ISO standards and the demanding requirements of operators, leasing companies, and maintenance providers handling intermodal tank containers for liquids, gases, and chemicals.</p>
                    <p>We understand that safety, durability, and compliance are critical in ISO tank operations. That’s why we only provide genuine and certified spares from leading manufacturers and OEMs, ensuring extended service life and minimal downtime.</p>
                    <blockquote>Precision in Every Part. Trust in Every Transaction.</blockquote>
                </div>
                <div class="col-lg-6 wow fadeIn" data-wow-delay="100ms">
                    <div class="image-hover d-inline-block z-index-1">
                        <img src="~/images/external/leadershipteam.jpg" class="rounded" alt="About Image1" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 wow fadeIn" data-wow-delay="200ms">
                    <h2 class="mb-lg-1-9">Our ISO Tank Spares Include</h2>
                    <p><b>Valves & Fittings:</b> Safety Relief Valves, Foot Valves, Ball Valves, Airline Valves, and Butterfly Valves.</p>
                    <p><b>Manlids, Seals & Gaskets:</b> Standard and custom Manlid Assemblies, Seals, and Gaskets Compatible with various Tank Designs.</p>
                    <p><b>Gauges & Instruments:</b> Pressure Gauges, Temperature Sensors, Level Indicators, and Calibration Component.</p>
                </div>
                <div class="col-lg-6 wow fadeIn" data-wow-delay="100ms">
                    <div class="image-hover d-inline-block z-index-1">
                        <img src="~/images/external/Image3.jpg" class="rounded" alt="Tanker Parts" style="max-height: 360px;" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 wow fadeIn" data-wow-delay="200ms">
                    <h2 class="mb-lg-1-9">BIP PEROLO GROUP</h2>
                    <p>Bulk Flo Agencies LLP represent Perolo as Stockists and distributors of Perolo Valves and ISO Tank Fittings throughout the Indian Markets, Perolo Specializes in ISO Tank Safety and fluid transfer Equipment for Oil, Chemicals, Powders, Liquefied Gas and Foodstuffs.</p>
                    <p>We are the official and authorized distributor of BIP PEROLO GROUP for the Indian market. Through this partnership, we provide our customers with high-quality tank safety and fluid transfer equipment, backed by Perolo's century-long legacy of innovation and reliability.</p>
                </div>
                <div class="col-lg-6 wow fadeIn" data-wow-delay="100ms">
                    <div class="image-hover d-inline-block z-index-1">
                        <img src="~/images/external/PereloBuilding.jpg" class="rounded" alt="Perelo Group Image" style="max-height: 360px;" />
                    </div>
                </div>
            </div>
